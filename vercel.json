{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/app/main.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/backend/(.*)", "dest": "backend/app/main.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
