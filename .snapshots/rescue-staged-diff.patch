+def test_a_recorded_cut_result_is_immutable(china):
+    db = china["db"]
+    reconciled(china, 4, 1)
+    row = db.query(Cut).one()
+    row.actual_good_blanks = 99
+    with pytest.raises(ValueError):
+        db.flush()
+    db.rollback()
