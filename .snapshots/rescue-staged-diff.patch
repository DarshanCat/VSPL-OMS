+import { AppShell } from "@/app/components/layout/AppShell";
+import StockContent from "./StockContent";
+
+export default function ContinuousCastingStockPage() {
+  return (
+    <AppShell>
+      <StockContent />
+    </AppShell>
+  );
+}
