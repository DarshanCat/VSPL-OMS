+    child = s.child_unit_id
+    assert (s.parent_remaining_length_mm, s.child_remaining_length_mm) == (365, 100)
+    h = step("/holds", UserRole.QA, dict(stock_unit_id=child, inward_id=iid, reason="surface crack"),
