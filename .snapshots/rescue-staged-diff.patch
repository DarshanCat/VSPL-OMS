+    r = step("/reservations/release", UserRole.PLANNER, dict(**base, length_mm=30), CCStockMovementResult)
+    assert (r.movement_type, r.unit_reserved_length_mm) == ("RELEASE", 35)
+    # split -> hold -> hold release on the child
